{
  "name": "baraguz-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Baraguz storefront: Vite + React, Shopify catalog, three checkouts (Shopify, Stripe, PayPal).",
  "scripts": {
    "import:catalog": "node scripts/import-catalog.mjs",
    "import:reviews": "node scripts/import-reviews.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "stripe": "17.4.0"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
