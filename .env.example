# Copy to Vercel → Project → Settings → Environment Variables. Never commit real values.

# Public address of this storefront (canonical links, Stripe and PayPal return pages).
SITE_URL=https://baraguz.com
# 1 on a staging or preview deployment: every page noindex, robots.txt disallows all. Unset on the live domain.
NOINDEX=1

# --- Shopify (always on: Shop Pay, cards, PayPal inside Shopify's checkout) ---
SHOPIFY_STORE_DOMAIN=baraguz.com
# Storefront API token (Shopify admin → Settings → Apps → Develop apps, or the Headless channel).
# Needed for Subscribe & save through Shopify's checkout; without it one-time carts use a cart link.
SHOPIFY_STOREFRONT_TOKEN=

# --- Record Stripe and PayPal sales as Shopify orders (fulfilment, inventory, reports) ---
# Custom app with write_orders. Domain is the myshopify.com one, e.g. baraguz.myshopify.com.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_DOMAIN=

# --- Stripe Checkout (cards, Apple Pay, Google Pay, Link; subscriptions billed by Stripe) ---
STRIPE_SECRET_KEY=
# Webhook endpoint https://<site>/api/webhooks/stripe, event checkout.session.completed.
STRIPE_WEBHOOK_SECRET=

# --- PayPal Orders (one-time carts) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or live
PAYPAL_ENV=sandbox

# --- Shipping for Stripe and PayPal orders (Shopify's checkout uses the store's own rates) ---
FREE_SHIPPING_FROM_CENTS=6000
# Set to the store's actual U.S. rate below the threshold, in cents. 0 until confirmed.
FLAT_SHIPPING_CENTS=0
